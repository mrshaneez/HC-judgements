# Copy to .env.local for local dev (never commit real secrets).
# In production these are set in the Vercel dashboard → Settings → Environment Variables.

# Admin login password for the /admin page:
ADMIN_PASSWORD=choose-a-strong-password

# Secret shared with the GitHub Action so it can POST to /api/ingest:
CRON_SECRET=another-long-random-string

# Optional: overrides the key used to sign admin sessions (defaults to ADMIN_PASSWORD):
# SESSION_SECRET=yet-another-random-string

# Postgres connection — Vercel injects these automatically when you attach a
# Postgres store to the project, so you normally do NOT set them by hand:
# POSTGRES_URL=...
